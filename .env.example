# Supabase Connection (Local Supabase CLI defaults shown; replace for hosted Supabase Free project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Privileged Key (NEVER expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL URL (for migrations, integration tests, and seed scripts)
DATABASE_URL=postgresql://postgres.project-ref:your-password@your-pooler-host:5432/postgres

# App URL & Defaults
NEXT_PUBLIC_APP_URL=http://localhost:4100
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_LOCALE=en-IN
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
